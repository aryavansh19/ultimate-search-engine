# Copy to .env and fill in what you need. Every value here has a working default,
# so the extractor runs with no .env at all.

# --- cache -------------------------------------------------------------------
# SQLite file holding envelopes + per-tier attempt telemetry.
EXTRACTOR_CACHE_PATH=data/extractor_cache.sqlite3

# --- network -----------------------------------------------------------------
EXTRACTOR_HTTP_TIMEOUT=15
EXTRACTOR_TIER_TIMEOUT=45

# --- yt-dlp ------------------------------------------------------------------
# Pull cookies from your own logged-in browser profile so Instagram works during
# local development. Format: browser[+keyring][:profile]. e.g. chrome, firefox, edge
# Use a throwaway account. Automated requests against your personal account are a
# good way to get it flagged.
# EXTRACTOR_COOKIES_FROM_BROWSER=chrome

# Alternatively point at an exported Netscape-format cookie file.
# EXTRACTOR_COOKIE_FILE=cookies.txt

# --- managed scraper API (tier 3) -------------------------------------------
# Left blank, the managed tier reports itself unavailable and the cascade skips it
# instead of recording a failure. Fill these in when you sign up with a provider
# (Bright Data, Apify, Scrape Creators, HikerAPI, ...).
# MANAGED_API_URL=https://api.example.com/v1/scrape
# MANAGED_API_KEY=
# MANAGED_API_AUTH_HEADER=Authorization
# MANAGED_API_AUTH_PREFIX=Bearer
# Comma-separated hosts to route through the managed tier. Empty means "any host".
# MANAGED_API_PLATFORMS=instagram,tiktok

# --- tier control ------------------------------------------------------------
# Comma-separated list to disable tiers without editing code.
# EXTRACTOR_DISABLED_TIERS=managed_api

# --- enrichment (tagging) ----------------------------------------------------
# Without a key the pipeline still runs: it falls back to offline keyword
# extraction, flags the result degraded, and costs nothing. Set the key to turn on
# real tagging.
# GEMINI_API_KEY=

# Models. Verified by calling the API rather than reading the model list, which lists
# names that 404 for new keys. Text and media both default to gemini-3.5-flash-lite,
# with gemini-3.5-flash as the media fallback.
# ENRICH_TEXT_MODEL=gemini-3.5-flash-lite
# ENRICH_MEDIA_MODEL=gemini-3.5-flash-lite
# ENRICH_MEDIA_FALLBACK=gemini-3.5-flash

# Cap on how much of a long video is analyzed. Also the only bound on cost when the
# duration is unknown, which is normal for YouTube now that oEmbed carries it.
# ENRICH_MAX_ANALYZE_SECONDS=180

# Set false to never send media, only text.
# ENRICH_ALLOW_MEDIA=true

# Video frames cost 70 tokens at low resolution and 280 at high. Low and medium are
# billed identically for video, so only turn this on for text-dense video: slides,
# code walkthroughs, dense on-screen captions.
# ENRICH_HIGH_RESOLUTION=false

# Refuse any single call predicted to cost more than this, and fall back to text.
# ENRICH_MAX_COST_PER_ITEM=0.25

# Skip media understanding entirely for videos longer than this many seconds.
# ENRICH_MAX_MEDIA_DURATION=900

# --- provider selection ------------------------------------------------------
# Ordered preference list for the tagging stage. The first provider that is both
# configured and able to handle the required mode wins.
#
#   gemini,ashna   (default) gemini first, gateway as automatic fallback
#   ashna,gemini             gateway for text tagging, gemini still handles video
#   gemini                   gemini only
#   ashna                    gateway only; video items degrade to text tagging
#
# Verified capability split, by testing the live gateway rather than assuming:
#   - strict json_schema output   works, clean JSON, enums respected
#   - image input (data URL)      works
#   - /embeddings                 404, so search vectors always use gemini
#   - video input                 accepted then silently ignored; the model answers
#                                 from training knowledge, so it would fabricate.
#                                 Only gemini analyses video.
#
# `python -m enrichment providers` prints what is currently usable.
# ENRICH_PROVIDER=ashna,gemini

# OpenAI-compatible gateway. Defaults target Ashna; any compatible endpoint works.
# ASHNA_API_KEY=
# ASHNA_BASE_URL=https://api.ashna.ai/v1/api
# ASHNA_TEXT_MODEL=gemini-2.5-Flash
# COMPAT_MAX_TOKENS=3000
